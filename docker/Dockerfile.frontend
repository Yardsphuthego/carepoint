FROM node:22-bookworm-slim AS node
FROM python:3.14-slim
COPY --from=node /usr/local/ /usr/local/
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 REFLEX_TELEMETRY_ENABLED=false
WORKDIR /app
COPY frontend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 1000 carepoint \
    && chown -R carepoint:carepoint /app
COPY --chown=carepoint:carepoint frontend/rxconfig.py ./rxconfig.py
COPY --chown=carepoint:carepoint frontend/carepoint ./carepoint
COPY --chown=carepoint:carepoint frontend/assets ./assets
COPY --chown=carepoint:carepoint frontend/reflex.lock ./reflex.lock
USER carepoint
RUN reflex init --name carepoint --template blank --no-agents
EXPOSE 3000
CMD ["reflex", "run", "--env", "prod", "--single-port", "--frontend-port", "3000", "--backend-port", "3000", "--backend-host", "0.0.0.0"]
