DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://appointments.example.com

DB_ENGINE=django.db.backends.mysql
DB_NAME=health_appointments
DB_USER=health_app
DB_PASSWORD=replace-this-password
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=replace-this-root-password

DEFAULT_FROM_EMAIL=appointments@example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True

# Public URL of the Reflex landing page
CAREPOINT_FRONTEND_URL=http://localhost:3000
